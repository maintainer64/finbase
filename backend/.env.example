# Public Authelia issuer URL, without a trailing slash.
FINBASE_OIDC_ISSUER=https://auth.example.com
FINBASE_OIDC_CLIENT_ID=finbase
# Confidential client secret configured for the same client in Authelia.
FINBASE_OIDC_CLIENT_SECRET=replace-me
FINBASE_OIDC_DISPLAY_NAME=Authelia

# Optional idempotent demo data on container startup (true/false).
FINBASE_DEMO=false
FINBASE_DEMO_DAYS=180

# Window for automatic transfer matching (1-1440 minutes).
FINBASE_TRANSFER_WINDOW_MINUTES=30
