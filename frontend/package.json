{
  "name": "finbase",
  "repository": "maintainer64/finbase",
  "version": "1.3.0",
  "description": "Finbase personal finance browser extension",
  "main": "src/index.tsx",
  "scripts": {
    "start": "vite",
    "build": "rm -rf finbase build.zip && vite build && vite build --config vite-service-worker.config.ts && cp -R build finbase && zip -r -m build.zip finbase",
    "dev": "pnpm build && ./install.sh dev",
    "serve": "vite preview",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "test": "vitest run test/settings.test.ts test/finbase-token.test.ts",
    "test:integration": "vitest run test/",
    "issue:token": "tsx scripts/issue-token.ts",
    "prepare": "cd .. && frontend/node_modules/.bin/husky"
  },
  "private": false,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/chrome": "^0.2.2",
    "@types/node": "^24.13.3",
    "csv-parse": "^7.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.64.0",
    "vite": "8.1.4",
    "vite-plugin-progress": "^0.0.7",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@solid-primitives/storage": "^4.4.0",
    "crypto-js": "^4.2.0",
    "echarts": "^6.1.0",
    "isdayoff": "^1.0.1",
    "lucide-solid": "^1.32.0",
    "pocketbase": "^0.27.3",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.14",
    "solid-toast": "^0.5.0"
  },
  "packageManager": "pnpm@11.13.0"
}
